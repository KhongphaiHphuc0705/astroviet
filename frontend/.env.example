VITE_API_BASE_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:5173

# Build-time prerender strict mode (set PRERENDER_STRICT=true in production deploy pipelines
# alongside an https:// non-localhost VITE_SITE_URL). Defaults to false for local/CI builds.
# PRERENDER_STRICT=false

# Conditional client hydration for prerendered Knowledge Base routes (D-F6-P2, D-F6.5-04).
# Enabled by default after Owner PASS on F6.5.8 hydration gate (`npm run verify:hydration`).
# Set to false to disable hydration and fall back to CSR `createRoot`.
# VITE_ENABLE_HYDRATION=true
